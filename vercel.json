{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "80x.ai"
        }
      ],
      "destination": "https://fein.vc/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.80x.ai"
        }
      ],
      "destination": "https://fein.vc/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "80x.ai"
        }
      ],
      "destination": "https://fein.vc/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.80x.ai"
        }
      ],
      "destination": "https://fein.vc/:path*",
      "permanent": true
    },
    {
      "source": "/:slug(self-host|pricing|deploy|demo|security|integrations|private-equity|fundraising|portfolio|b|pe|deck|video|llms\\.txt|llms-full\\.txt|site\\.webmanifest|og\\.png)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:slug(self-host|pricing|deploy|demo|security|integrations|private-equity|fundraising|portfolio|b|pe|deck|video)/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/privacy/:path*",
      "destination": "/terms",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=()"
        }
      ]
    },
    {
      "source": "/(favicon.svg|favicon.ico|apple-touch-icon.png|logo.svg|logo.png|logo-128.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(robots.txt|sitemap.xml)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(site.css|site.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "cleanUrls": true
}
